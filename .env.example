# ─────────────────────────────────────────────────────────────
# Shared / infra
# ─────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=voxaai

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
POSTGRES_USER=voxa
POSTGRES_PASSWORD=voxa_password
POSTGRES_DB=voxaai
# Host port for the Postgres container. Change if 5433 is also taken.
# (Containers always reach the DB internally on db:5432.)
POSTGRES_HOST_PORT=5433
# When running via docker-compose the host is "db"; locally use "localhost"
DATABASE_URL=postgresql+psycopg://voxa:voxa_password@localhost:5432/voxaai

# ─────────────────────────────────────────────────────────────
# Backend / Security
# ─────────────────────────────────────────────────────────────
SECRET_KEY=voxai-calling-agent
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000
# Public URL of the frontend (used to build verification / reset links in emails)
FRONTEND_URL=http://localhost:3000
# Set to true in production to require verified email before using the app
REQUIRE_EMAIL_VERIFICATION=false

# Bootstrap super admin
SUPERADMIN_EMAIL=admin@nextcall.ai
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_NAME=Platform Admin

# ─────────────────────────────────────────────────────────────
# Vapi (INTERNAL ONLY — never exposed to clients)
# ─────────────────────────────────────────────────────────────
# Active voice infrastructure provider. Only "vapi" is implemented today;
# the VoiceProvider abstraction lets you add "retell"/"bland"/etc. later.
VOICE_PROVIDER=vapi
VAPI_API_KEY=500fb1f9-cc77-46d2-b8c1-39786b7e6fca
VAPI_BASE_URL=https://api.vapi.ai
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret
# Public key from the Vapi dashboard (API Keys → Public). Enables in-browser Talk.
VAPI_PUBLIC_KEY=your-vapi-public-key

# ─────────────────────────────────────────────────────────────
# AI / Voice providers (configured inside Vapi assistants)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-key
DEEPGRAM_API_KEY=your-deepgram-key

# ─────────────────────────────────────────────────────────────
# Telephony
# ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token

# ─────────────────────────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_GROWTH=price_growth_id
STRIPE_PRICE_PRO=price_pro_id

# ─────────────────────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────────────────────
# Preferred: Resend HTTPS API. Works on ANY host, including Render's free tier
# which blocks SMTP ports (25/465/587). If RESEND_API_KEY is set it takes
# priority over SMTP. Verify the nextcall.online domain in your Resend dashboard
# so EMAIL_FROM (info@nextcall.online) is allowed as the sender.
RESEND_API_KEY=

# Fallback: SMTP (Hostinger mailbox: info@nextcall.online).
# Leave SMTP_HOST blank for local dev — emails are logged to the console instead.
# Hostinger SMTP: host=smtp.hostinger.com, port 465 (SSL) or 587 (STARTTLS).
# NOTE: Render free-tier web services block outbound SMTP — use Resend there.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@nextcall.online
SMTP_PASSWORD=your-mailbox-password
EMAIL_FROM=info@nextcall.online
EMAIL_FROM_NAME=NextCall
# Recipient used only by scripts/send_test_email.py (defaults to SMTP_USER).
MAIL_TO=info@nextcall.online

# ─────────────────────────────────────────────────────────────
# Storage (local | s3)
# ─────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
PUBLIC_BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=NextCall
