# Keep the build context small and never ship local/dev artifacts or secrets.
node_modules/
.next/
out/
build/
dist/
coverage/

# Secrets & local env — must never enter an image layer.
.env
.env.*
!.env.example

# VCS / editor / OS noise
.git/
.gitignore
.idea/
.vscode/
*.swp
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
