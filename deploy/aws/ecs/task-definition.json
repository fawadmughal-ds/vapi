{
  "family": "voxaai-prod",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/voxaai/backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "command": [
        "sh",
        "-c",
        "python -m app.seed && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2"
      ],
      "environment": [
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "FRONTEND_URL", "value": "https://app.YOURDOMAIN.com" },
        { "name": "PUBLIC_BASE_URL", "value": "https://app.YOURDOMAIN.com" },
        { "name": "BACKEND_CORS_ORIGINS", "value": "https://app.YOURDOMAIN.com" },
        { "name": "REQUIRE_EMAIL_VERIFICATION", "value": "true" },
        { "name": "STORAGE_BACKEND", "value": "local" },
        { "name": "STORAGE_LOCAL_DIR", "value": "/app/storage" }
      ],
      "secrets": [
        { "name": "SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:voxaai/production:SECRET_KEY::" },
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:voxaai/production:DATABASE_URL::" },
        { "name": "VAPI_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:voxaai/production:VAPI_API_KEY::" },
        { "name": "VAPI_WEBHOOK_SECRET", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:voxaai/production:VAPI_WEBHOOK_SECRET::" },
        { "name": "STRIPE_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:voxaai/production:STRIPE_SECRET_KEY::" },
        { "name": "STRIPE_WEBHOOK_SECRET", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:voxaai/production:STRIPE_WEBHOOK_SECRET::" },
        { "name": "SUPERADMIN_EMAIL", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:voxaai/production:SUPERADMIN_EMAIL::" },
        { "name": "SUPERADMIN_PASSWORD", "valueFrom": "arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:voxaai/production:SUPERADMIN_PASSWORD::" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/voxaai-prod",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "backend"
        }
      }
    },
    {
      "name": "frontend",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/voxaai/frontend:latest",
      "essential": true,
      "dependsOn": [
        {
          "containerName": "backend",
          "condition": "HEALTHY"
        }
      ],
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "BACKEND_INTERNAL_URL", "value": "http://localhost:8000" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:3000/ || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 90
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/voxaai-prod",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ]
}
